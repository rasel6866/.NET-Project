@model List<BLL.DTOs.UserDTO>

<h2>User List</h2>
<a href="/Auth/Dashboard" class="btn btn-secondary">
    Back To Dashboard </a>

<a href="/User/Create" class="btn btn-primary">Create</a>

<table class="table table-bordered">

    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Role</td>

            <td>
                <a href="/User/Edit/@item.Id" class="btn btn-warning">Edit</a>

                <a href="/User/Delete/@item.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }

</table>